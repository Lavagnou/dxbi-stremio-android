    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="7dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="7dp" /></shape>
    </item>
</selector>
