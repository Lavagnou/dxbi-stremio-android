<?xml version="1.0" encoding="utf-8"?>
<!-- An episode card in the TV player's Episodes row -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
