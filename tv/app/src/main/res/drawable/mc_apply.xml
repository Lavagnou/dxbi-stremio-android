<?xml version="1.0" encoding="utf-8"?>
<!-- Apply on the Audio & Subtitles panel: a white button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#FFD6D6D6" /><corners android:radius="4dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="4dp" /></shape>
    </item>
</selector>
