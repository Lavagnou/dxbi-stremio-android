<?xml version="1.0" encoding="utf-8"?>
<!-- Skip Intro / Next Episode on a TV: white while the remote is on it, outlined over the controls -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFFFFFFF" /><corners android:radius="5dp" /><stroke android:width="1.5dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#99000000" /><corners android:radius="5dp" /><stroke android:width="1.5dp" android:color="#FFFFFFFF" /></shape>
    </item>
</selector>
