<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_buffering="when_playing"
        app:show_timeout="7000"
        app:show_subtitle_button="true"
        app:show_shuffle_button="false"
        app:show_next_button="false"
        app:show_previous_button="false" />

    <!-- Title over the top of the picture while the controls are showing -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/title_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/player_title_pad_side"
        android:paddingTop="@dimen/player_title_pad_top"
        android:paddingEnd="@dimen/player_title_pad_side"
        android:paddingBottom="@dimen/player_title_pad_bottom">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="@dimen/player_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/player_subtitle_text" />
    </LinearLayout>

    <!-- Skip intro / recap / credits, while one is playing (times from Nathflix) -->
    <TextView
        android:id="@+id/skip_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/player_skip_margin_end"
        android:layout_marginBottom="@dimen/player_skip_margin_bottom"
        android:background="@drawable/skip_bg"
        android:focusable="true"
        android:paddingStart="@dimen/player_skip_pad_side"
        android:paddingTop="@dimen/player_skip_pad_top_bottom"
        android:paddingEnd="@dimen/player_skip_pad_side"
        android:paddingBottom="@dimen/player_skip_pad_top_bottom"
        android:textColor="#FF000000"
        android:textSize="@dimen/player_skip_text"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Brief feedback for seeks made without the controls (±10 s) -->
    <TextView
        android:id="@+id/seek_flash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="@dimen/player_flash_margin_top"
        android:background="@drawable/flash_bg"
        android:paddingStart="@dimen/player_flash_pad_side"
        android:paddingTop="@dimen/player_flash_pad_top_bottom"
        android:paddingEnd="@dimen/player_flash_pad_side"
        android:paddingBottom="@dimen/player_flash_pad_top_bottom"
        android:textColor="@android:color/white"
        android:textSize="@dimen/player_flash_text"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
