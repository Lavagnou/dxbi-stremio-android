<?xml version="1.0" encoding="utf-8"?>
<!-- The player's controls on a phone or tablet, laid out like Netflix's app: back and title at the
     top, -10 s / play / +10 s in the middle, the seek bar and a centred row of small buttons at the
     bottom. Built in MobilePlayerControls (inflated in Nathflix's language); a TV keeps Media3's own
     controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Taps, double taps and slides land here (whatever the controls don't take) -->
    <View
        android:id="@+id/mc_gestures"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/mc_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_gravity="top"
            android:background="@drawable/mc_scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="bottom"
            android:background="@drawable/mc_scrim_bottom" />

        <!-- Top: back, the title in the middle, picture-in-picture -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/mc_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/mc_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="64dp"
                android:layout_marginEnd="64dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/mc_pip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_pip"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pip" />
        </FrameLayout>

        <!-- Middle: back 10 s, play / pause, forward 10 s -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/mc_rewind"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_back_10">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_replay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="10"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/mc_play"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="72dp"
                android:layout_marginEnd="72dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_play_pause"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause" />

            <FrameLayout
                android:id="@+id/mc_forward"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_forward_10">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_forward" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="10"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom: the seek bar with the time left, then the row of buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/mc_timebar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    app:bar_height="3dp"
                    app:buffered_color="#59FFFFFF"
                    app:played_color="@color/accent"
                    app:scrubber_color="@color/accent"
                    app:scrubber_dragged_size="20dp"
                    app:scrubber_enabled_size="13dp"
                    app:unplayed_color="#33FFFFFF" />

                <TextView
                    android:id="@+id/mc_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mc_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/mc_speed" style="@style/Nathflix.PlayerButton" android:drawableStart="@drawable/ic_speed" />
                <TextView android:id="@+id/mc_lock" style="@style/Nathflix.PlayerButton" android:drawableStart="@drawable/ic_lock_open" android:text="@string/player_lock" />
                <TextView android:id="@+id/mc_episodes" style="@style/Nathflix.PlayerButton" android:drawableStart="@drawable/ic_episodes" android:text="@string/player_episodes" />
                <TextView android:id="@+id/mc_audio" style="@style/Nathflix.PlayerButton" android:drawableStart="@drawable/ic_subtitles" android:text="@string/player_audio_subtitles" />
                <TextView android:id="@+id/mc_next" style="@style/Nathflix.PlayerButton" android:drawableStart="@drawable/ic_skip_next" android:text="@string/player_next_episode" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Locked: only this, until it's tapped -->
    <LinearLayout
        android:id="@+id/mc_unlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/mc_lock_ring"
            android:padding="7dp"
            android:src="@drawable/ic_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/player_locked"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_tap_to_unlock"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Double tap feedback: -10 s on the left, +10 s on the right -->
    <TextView
        android:id="@+id/mc_tap_back"
        style="@style/Nathflix.PlayerBubble"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="56dp" />

    <TextView
        android:id="@+id/mc_tap_forward"
        style="@style/Nathflix.PlayerBubble"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="56dp" />

    <!-- Brightness (slide on the left) and volume (slide on the right) -->
    <LinearLayout
        android:id="@+id/mc_level"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="@drawable/mc_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/mc_level_icon"
            android:layout_width="22dp"
            android:layout_height="22dp" />

        <ProgressBar
            android:id="@+id/mc_level_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:max="100"
            android:progressTint="@android:color/white" />
    </LinearLayout>

    <!-- Speed, Audio & Subtitles and Episodes open over the picture, filled in by MobilePlayerControls -->
    <FrameLayout
        android:id="@+id/mc_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EB000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/mc_panel_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/mc_panel_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/player_close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </FrameLayout>
</FrameLayout>
