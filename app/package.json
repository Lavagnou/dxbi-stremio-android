{
	"name": "nathflix",
	"version": "0.4.0",
	"description": "Nathflix: a Netflix-style desktop app for Stremio, with the Nathflix experience built in.",
	"main": "./dist/main.js",
	"scripts": {
		"dist": "node ./copyComponents.js --plugin-only && tsc && node ./copyComponents.js",
		"watch": "tsc -w",
		"lint": "eslint -c .eslintrc --ext .ts ./src",
		"dev": "node -e \"console.clear()\" && npm run dist && npx electron --log-level=3 ./dist/main.js --devtools",
		"build": "npm run dist && electron-builder",
		"build:linux:x64": "npm run dist && electron-builder --linux --x64",
		"build:linux:arm64": "npm run dist && electron-builder --linux --arm64",
		"build:mac:x64": "npm run dist && electron-builder --mac --x64",
		"build:mac:arm64": "npm run dist && electron-builder --mac --arm64",
		"build:win:x64": "npm run dist && electron-builder --win --x64",
		"build:win:arm64": "npm run dist && electron-builder --win --arm64",
		"build:win": "npm run dist && electron-builder --win"
	},
	"repository": "https://github.com/lavagnou/dxbi-stremio-android.git",
	"publish": {
		"provider": "github",
		"releaseType": "release"
	},
	"author": "lavagnou",
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@types/unzipper": "^0.10.11",
		"electron": "^41.1.0",
		"electron-builder": "^26.4.0",
		"typescript": "^5.7.2"
	},
	"dependencies": {
		"@xhayper/discord-rpc": "^1.2.1",
		"discord-api-types": "^0.37.119",
		"electron-updater": "^6.6.2",
		"koffi": "3.3.3",
		"marked": "^15.0.7",
		"p-limit": "^7.2.0",
		"unzipper": "^0.12.3",
		"winston": "^3.11.0"
	},
	"optionalDependencies": {
		"dmg-license": "^1.0.11"
	},
	"build": {
		"appId": "com.lavagnou.nathflix.desktop",
		"productName": "Nathflix",
		"asar": true,
		"icon": "images/icon",
		"directories": {
			"output": "release-builds"
		},
		"publish": {
			"provider": "github",
			"owner": "lavagnou",
			"repo": "dxbi-stremio-android"
		},
		"asarUnpack": [
			"**/register-scheme/build/Release/*.node",
			"**/register-scheme/node-addon-api/src/node-api.target.mk",
			"**/node_modules/@koromix/koffi-*/**"
		],
		"win": {
			"target": [
				{
					"target": "nsis"
				},
				{
					"target": "portable"
				}
			],
			"extraResources": [
				{
					"from": "mpv",
					"to": "mpv"
				}
			]
		},
		"mac": {
			"target": "dmg",
			"icon": "images/icon.icns"
		},
		"linux": {
			"target": "AppImage",
			"icon": "images/icon.png",
			"category": "AudioVideo",
			"executableName": "nathflix"
		},
		"artifactName": "nathflix-${os}-${arch}.${ext}",
		"nsis": {
			"artifactName": "nathflix-Setup-${arch}.${ext}"
		},
		"portable": {
			"artifactName": "nathflix-portable-${arch}.${ext}"
		},
		"protocols": [
			{
				"name": "Stremio addon links",
				"schemes": [
					"stremio"
				]
			}
		],
		"files": [
			"dist/**/*",
			"!dist/**/*.map",
			"static/**/*",
			"version",
			"LICENSE.md",
			"COPYING",
			"images/icon.png",
			"images/icon.ico",
			"package.json"
		]
	},
	"allowScripts": {
		"electron@41.1.0": true
	}
}
